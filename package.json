{
  "name": "design-blog-dashboard-skin",
  "private": true,
  "scripts": {
    "skin:build": "tailwindcss -i dashboard-skin/src/input.css -o dashboard-skin/tailwind.css --minify && bun dashboard-skin/tools/build-style.mjs",
    "skin:watch": "tailwindcss -i dashboard-skin/src/input.css -o dashboard-skin/tailwind.css --watch",
    "skin:build:style": "bun dashboard-skin/tools/build-style.mjs",
    "skin:preview": "bun dashboard-skin/tools/make-preview.mjs",
    "skin:serve": "bun dashboard-skin/tools/serve.mjs",
    "skin:verify:content": "bun dashboard-skin/tools/verify-content.mjs",
    "skin:verify:prose": "bun dashboard-skin/tools/verify-prose.mjs",
    "skin:verify:codeblock": "bun dashboard-skin/tools/verify-codeblock.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "playwright": "^1.62.1",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^4.3.3"
  }
}
